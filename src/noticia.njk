---
pagination:
  data: noticias
  size: 1
  alias: noticia
permalink: "noticias/{{ noticia.customSlug }}/index.html"
layout: "base.njk"
eleventyComputed:
  title: "{{ noticia.title }}"
  description: "{{ noticia.excerpt | striptags | truncate(160) }}"
---

<section class="cabecera-pagina">
  <div class="contenedor">
    <div class="migas-pan">
      <a href="{{ '/' | url }}">Inicio</a> / <a href="{{ '/noticias/' | url }}">Noticias</a> / {{ noticia.title }}
    </div>
    <h1>{{ noticia.title }}</h1>
    <p class="mt-2">{{ noticia.date | dateFormat }}</p>
  </div>
</section>

<section class="seccion">
  <div class="contenedor">
    <article class="contenido-pagina">
      {% if noticia.image %}
      <img src="{{ noticia.image | url }}" alt="{{ noticia.title }}" class="noticia-imagen-principal">
      {% endif %}
      <div class="noticia-contenido">
        {{ noticia.content | safe }}
      </div>
      <div class="mt-4">
        <a href="{{ noticia.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Ver noticia original en onesvie.gob.do</a>
      </div>
    </article>
  </div>
</section>
