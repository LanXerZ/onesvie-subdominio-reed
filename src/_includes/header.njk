<header class="header">
  <div class="contenedor">
    <div class="logo-area">
      <img src="{{ '/img/LOGO_FAVICON01.jpg' | url }}" alt="Logo ONESVIE" onerror="this.style.display='none'">
      <div class="logo-texto">
        <p class="titulo-institucion">ONESVIE</p>
        <p class="subtitulo-institucion">Oficina Nacional de Evaluación Sísmica y Vulnerabilidad de Infraestructura y Edificaciones</p>
      </div>
    </div>
    <button class="btn-menu-movil" aria-label="Abrir menú de navegación" aria-expanded="false" id="btnMenuMovil">&#9776;</button>
    <nav class="nav-principal" id="navPrincipal" aria-label="Navegación principal">
      <ul>
        <li><a href="{{ '/' | url }}" class="{% if page.url == '/' %}activo{% endif %}">Inicio</a></li>
        <li><a href="{{ '/sobre-iniciativa/' | url }}" class="{% if page.url == '/sobre-iniciativa/' %}activo{% endif %}">Sobre la Iniciativa</a></li>
        <li><a href="{{ '/oferta-academica/' | url }}" class="{% if page.url == '/oferta-academica/' %}activo{% endif %}">Oferta Académica</a></li>
        <li><a href="{{ '/inscripcion/' | url }}" class="{% if page.url == '/inscripcion/' %}activo{% endif %}">Inscripción</a></li>
        <li><a href="{{ '/noticias/' | url }}" class="{% if page.url == '/noticias/' %}activo{% endif %}">Noticias</a></li>
        <li><a href="{{ '/contacto/' | url }}" class="{% if page.url == '/contacto/' %}activo{% endif %}">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>
